# Proto-OKN
OKN_MCP_URL=https://apps.okn.us/okn-mcp-dev/mcp
OKN_MCP_TIMEOUT_SECONDS=60

# Model provider
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional paid-provider fallback
OPENAI_API_KEY=
OPENAI_MODEL=

# Literature services
NCBI_EMAIL=
NCBI_TOOL=okn-guard
NCBI_API_KEY=
CROSSREF_MAILTO=

# Search reproducibility
LITERATURE_SEARCH_CUTOFF=
MAX_PAPERS_PER_BRANCH=20
MAX_PROVENANCE_HOPS=3
MAX_QUERY_REFORMULATIONS=3

# Local persistence
DATABASE_URL=sqlite+aiosqlite:///./data/okn_guard.db
RUN_ARTIFACT_DIR=artifacts/runs

# Logging
LOG_LEVEL=INFO